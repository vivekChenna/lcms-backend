NODE_ENV=development
# The frontend calls http://localhost:4000 by default: set PORT=4000 (or change VITE_API_BASE_URL there).
PORT=3000
DATABASE_URL=postgres://lcms:lcms@localhost:5442/lcms_dev
JWT_ACCESS_SECRET=change-me-to-a-32-plus-character-secret-value
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Document storage (any S3-compatible server; RustFS in dev — see docker-compose.dev.yml)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lcms-documents
S3_ACCESS_KEY_ID=lcms
S3_SECRET_ACCESS_KEY=lcms12345
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=26214400
UPLOAD_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,png,jpg,jpeg,txt

# Email notifications (SMTP; MailHog in dev — see docker-compose.dev.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=lcms@algihaz.local

# Public address of the frontend (scheme, host, port; no trailing slash). Invitation and password-reset
# emails link to ${FRONTEND_URL}/set-password, so without it those emails cannot be sent.
FRONTEND_URL=http://localhost:5173

# Browser access (CORS) and cookie settings for the frontend
# Must list the frontend origin even when same-origin: with it empty, cookie-authenticated writes are rejected (403 CSRF_BLOCKED) and the app logs a startup warning.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# COOKIE_SECURE defaults to true only when NODE_ENV=production
# COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.algihaz.example

# Sign-in method: local (email + password, default) or drona (DronaHQ container; turns password sign-in off)
AUTH_STRATEGY=local

# Postgres schema for all LCMS tables (default public). Use a dedicated one such as lcms in a shared database.
# DB_SCHEMA=lcms
